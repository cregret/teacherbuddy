{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/model", "destination": "/api/model.json" },
    { "source": "/api/workspace", "destination": "/api/workspace.json" },
    { "source": "/api/learning", "destination": "/api/learning.json" },
    { "source": "/api/state", "destination": "/api/state.json" },
    { "source": "/api/health", "destination": "/api/health.json" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "same-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    }
  ]
}
